{"wireMagic":"pb3","pens":[{}],"wsWinStyles":[{}],"wpWinPositions":[{}],"events":[{"tStartMs":0,"dDurationMs":3860,"segs":[{"utf8":"Guten Tag, hier ist die Tagesschau in 100 Sekunden."}]},{"tStartMs":4160,"dDurationMs":1460,"segs":[{"utf8":"Jugendproteste in Deutschland."}]},{"tStartMs":5620,"dDurationMs":1920,"segs":[{"utf8":"In mehr als 30 Städten gingen gestern junge"}]},{"tStartMs":7540,"dDurationMs":2240,"segs":[{"utf8":"Menschen auf die Straße, um für eine bessere"}]},{"tStartMs":9780,"dDurationMs":3900,"segs":[{"utf8":"Bildung, mehr Klimaschutz und bezahlbaren Wohnraum zu demonstrieren."}]},{"tStartMs":13680,"dDurationMs":3560,"segs":[{"utf8":"Aufgerufen hatte dazu die Initiative Gen Z regelt."}]},{"tStartMs":17240,"dDurationMs":4640,"segs":[{"utf8":"Die Demonstrationen verliefen weitgehend friedlich und sollen fortgeführt werden."}]},{"tStartMs":22320,"dDurationMs":2900,"segs":[{"utf8":"Ausschreitungen nach Gen Z-Protesten in Frankfurter Main."}]},{"tStartMs":25220,"dDurationMs":3440,"segs":[{"utf8":"In der Innenstadt wurden Schaufenster eingeschlagen und Geschäfte geplündert."}]},{"tStartMs":28660,"dDurationMs":3580,"segs":[{"utf8":"Als Rwanda-Lira ein Waffengeschäft attackierten, stellte die Polizei"}]},{"tStartMs":32240,"dDurationMs":1620,"segs":[{"utf8":"bei ihnen Waffen sicher."}]},{"tStartMs":33860,"dDurationMs":2760,"segs":[{"utf8":"Mehr als 30 Menschen wurden festgenommen, die Innenstadt"}]},{"tStartMs":36620,"dDurationMs":2500,"segs":[{"utf8":"war zeitweise gesperrt."}]},{"tStartMs":39700,"dDurationMs":1980,"segs":[{"utf8":"IG Metall beginnt mit Warnstreiks."}]}]}
